{
    "name": "telegram-bot-essentials/settings",
    "description": "Settings support built for telegram-bot-essentials/essence",
    "type": "library",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12",
        "telegram-bot-essentials/essence": ">=0.9 <1.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.7 || ^4.0",
        "pestphp/pest-plugin-laravel": "^3.1 || ^4.0"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "TelegramBotEssentials\\Settings\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "TelegramBotEssentials\\Settings\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Elyar",
            "email": "elyareranjbar@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Elyar0/telegram-bot-essentials"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "TelegramBotEssentials\\Settings\\TbeSettingsServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-chore/locale-lazy-handlers": "0.0.17.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse"
    }
}
